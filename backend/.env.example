# MongoDB connection string (e.g. a free MongoDB Atlas cluster)
DATABASE_URL=mongodb://localhost:27017/travelets
# Long random string used to sign login tokens
TOKEN_SECRET=change-me
# Login token lifetime in seconds
TOKEN_EXPIRE=3600
# Google Maps Platform key with the Places API enabled
GOOGLE_API_KEY=
# Frontend URL(s) allowed by CORS, comma-separated
CLIENT_ORIGIN=http://localhost:3000
PORT=3005
